<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:RisContentPipeline.GUI.Controls">
    <Design.PreviewWith>
        <controls:FlipYCheckBox />
    </Design.PreviewWith>

    <Style Selector="controls|FlipYCheckBox">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="120,*">
                    <TextBlock Text="Flip Y" 
                               VerticalAlignment="Center" 
                               ToolTip.Tip="If checked generated image will be flipped vertically."/>
                    <CheckBox Grid.Column="1" 
                              Margin="12, 4" 
                              VerticalAlignment="Center"
                              IsChecked="{TemplateBinding IsChecked, Mode=TwoWay}"
                              />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
