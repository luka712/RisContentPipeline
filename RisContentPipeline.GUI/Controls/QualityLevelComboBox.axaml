<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:RisContentPipeline.GUI.Controls">
    <Design.PreviewWith>
        <controls:QualityLevelComboBox />
    </Design.PreviewWith>

    <Style Selector="controls|QualityLevelComboBox">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Quality Level" VerticalAlignment="Center" ToolTip.Tip="The quality level of encoded KTX2 file, if applicable." />
                    <ComboBox Grid.Column="1"
                              Margin="8,4"
                              ItemsSource="{TemplateBinding  QualityLevels}"
                              SelectedIndex="{TemplateBinding SelectedIndex, Mode=TwoWay}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>