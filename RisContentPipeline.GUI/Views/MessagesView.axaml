<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:viewModels="clr-namespace:RisContentPipeline.GUI.ViewModels"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:models="clr-namespace:RisContentPipeline.GUI.Models"
             x:DataType="viewModels:MainViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RisContentPipeline.GUI.Views.MessagesView">
    <suki:GlassCard Margin="10" Classes="Primary">
        <DataGrid ItemsSource="{Binding Messages}" CanUserReorderColumns="True" CanUserSortColumns="True"
                  IsReadOnly="True">
            <DataGrid.Columns>
                
                <!-- Icon -->
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <avalonia:MaterialIcon Classes="Icon"
                                                       IsVisible="{Binding LogLevel, Converter={StaticResource EqualsConverter}, ConverterParameter={StaticResource InfoMessage}}"
                                                       Kind="Info" />
                                <avalonia:MaterialIcon Classes="Icon"
                                                       Foreground="{StaticResource Warning}"
                                                       IsVisible="{Binding LogLevel, Converter={StaticResource EqualsConverter}, ConverterParameter={StaticResource WarningMessage}}"
                                                       Kind="Warning" />
                                <avalonia:MaterialIcon Classes="Icon"
                                                       Foreground="{StaticResource Error}"
                                                       IsVisible="{Binding LogLevel, Converter={StaticResource EqualsConverter}, ConverterParameter={StaticResource ErrorMessage}}"
                                                       Kind="Error" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- Timestamp -->
                <DataGridTextColumn Header="Timestamp"
                                    Width="150"
                                    Binding="{Binding Timestamp, Converter={StaticResource DateTimeConverter}, Mode=OneWay}" />
                
                <!-- Message -->
                <DataGridTemplateColumn Header="Message">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" ToolTip.Tip="{Binding Message}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                
            </DataGrid.Columns>
        </DataGrid>
    </suki:GlassCard>
</UserControl>