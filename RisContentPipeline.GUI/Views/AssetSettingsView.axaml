<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:viewModels="clr-namespace:RisContentPipeline.GUI.ViewModels"
             xmlns:controls="clr-namespace:RisContentPipeline.GUI.Controls"
             x:DataType="viewModels:MainViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RisContentPipeline.GUI.Views.AssetSettingsView">
    <suki:GlassCard Margin="10" Classes="Primary">
        <suki:GroupBox Header="Settings">
            <StackPanel Orientation="Vertical" IsVisible="{Binding SelectedAsset, Converter={x:Static NotNullConverter.Instance}}">
                
                <!-- File path -->
                <controls:FilePathSelectableTextBlock FilePath="{Binding SelectedAsset?.AbsoluteFilePath}" />
                
                <!-- Build directory -->
                <controls:BuildDirectoryTextBox BuildDirectory="{Binding SelectedAsset?.BuildPath}" />
                
                <!-- Ktx2 settings -->
                <StackPanel Orientation="Vertical" IsVisible="{Binding SelectedAsset?.IsImage}">
                    <controls:EncodingTargetComboBox
                        SelectedEncodingTarget="{Binding SelectedAsset?.Image?.Ktx2Settings.EncodingTarget}" />
                    <controls:QualityLevelComboBox
                        SelectedIndex="{Binding SelectedAsset?.Image?.Ktx2Settings.QualityLevel}" />
                    <controls:GenerateMipMapCheckBox
                        IsChecked="{Binding SelectedAsset?.Image?.Ktx2Settings.GenerateMipmaps}" />
                    <controls:FlipYCheckBox IsChecked="{Binding SelectedAsset?.Image?.Ktx2Settings.FlipY}" />
                </StackPanel>
            </StackPanel>
        </suki:GroupBox>
    </suki:GlassCard>
</UserControl>