<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RisContentPipeline.GUI.App"
             xmlns:local="using:RisContentPipeline.GUI"
             xmlns:sukiUi="clr-namespace:SukiUI;assembly=SukiUI"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows the system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <sukiUi:SukiTheme ThemeColor="Blue"  />
        <StyleInclude Source="avares://SukiUI.Dock/Index.axaml" />
        <StyleInclude Source="Controls/EncodingTargetComboBox.axaml" />
        <StyleInclude Source="Controls/QualityLevelComboBox.axaml" />
        <StyleInclude Source="Controls/GenerateMipMapCheckBox.axaml" />
        <StyleInclude Source="Controls/FlipYCheckBox.axaml" />
    </Application.Styles>
    
</Application>