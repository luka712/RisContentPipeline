<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 xmlns:viewModels="clr-namespace:RisContentPipeline.GUI.ViewModels"
                 x:Class="RisContentPipeline.GUI.Windows.ImageViewerWindow"
                 Title="Image Viewer"
                 WindowStartupLocation="CenterOwner"
                 x:DataType="viewModels:AssetViewModel"
                 SizeToContent="WidthAndHeight"
                 Width="1000" Height="800"
                 CanResize="True">
        <NativeWebView Name="PartNativeWebView"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Source="{Binding Preferences?.LocalServerUri, Mode=OneTime}"
                       NavigationCompleted="PartNativeWebView_OnNavigationCompleted" />
</suki:SukiWindow>