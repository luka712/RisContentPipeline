<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RisContentPipeline.GUI.Views.ImageViewerWindow"
        Title="Image Viewer"
        Width="500" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="KTX2/PNG Viewer" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>
        
        <StackPanel>
            <TextBlock Text="The image viewer is running in your browser." Margin="0,0,0,8"/>
            <TextBlock x:Name="UrlText" Text="http://localhost:5050" Foreground="Blue" Margin="0,0,0,16"/>
            
            <TextBlock Text="File:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="FilePathText" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,16"/>
            
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button x:Name="OpenBrowserButton" Content="Open in Browser" Click="OnOpenBrowserClick"/>
                <Button Content="Close" Click="OnCloseClick"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
