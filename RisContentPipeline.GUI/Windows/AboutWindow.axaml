<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 x:Class="RisContentPipeline.GUI.Windows.AboutWindow"
                 Title="About RisContentPipeline"
                 Width="400" Height="300"
                 WindowStartupLocation="CenterOwner"
                 CanResize="False">

    <StackPanel Margin="24" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="RisContentPipeline" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"/>
        
        <TextBlock Text="Version 1.0.0" 
                   HorizontalAlignment="Center"
                   Foreground="Gray"/>
        
        <TextBlock Text="A content pipeline tool for converting and processing game assets."
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="300"/>
        
        <TextBlock Text="Supports PNG to KTX2 conversion with various encoding options."
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="300"
                   Foreground="Gray"/>
        
        <Button Content="Close" 
                HorizontalAlignment="Center"
                Click="OnCloseClick"
                Margin="0,16,0,0"/>
    </StackPanel>
</suki:SukiWindow>
